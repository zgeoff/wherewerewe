{
  "$schema": "./node_modules/knip/schema.json",
  // repo-sync delivers .claude/ verbatim
  "ignore": [".claude/**"],
  // the shared oxlint config loads the plugin, the chex baseline in lefthook.yml runs diet, and the
  // synced start hook in .claude/ loads agent-hooks at run time, so knip sees none of them
  "ignoreDependencies": ["@stylistic/eslint-plugin", "@zgeoff/diet", "@zgeoff/agent-hooks"],
  "workspaces": {
    ".": { "entry": ["rig.config.ts", "scripts/**/*.test.ts"] },
    "packages/*": { "entry": ["src/**/*.test.ts"] }
  }
}
